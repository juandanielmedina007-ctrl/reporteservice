{
  "info": {
    "name": "Examen parcial - Reportes - Medina Garces",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registrar reporte",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reportes/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"12345678\",\n  \"tipo\": \"DOMICILIARIA\",\n  \"direccion\": \"Av. Los Parques 123, Chiclayo\",\n  \"referencia\": \"Frente al parque\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.environment.set(\"reporteId\", r.id);",
              "pm.test(\"Estado inicial 1\", () => pm.expect(r.estado).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar primeros cinco",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/?offset=0&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Máximo cinco\", () => pm.expect(pm.response.json().content.length).to.be.at.most(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Obtener detalle",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/{{reporteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Buscar por DNI",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/ciudadano/12345678"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"DNI coincide\", () => pm.response.json().forEach(r => pm.expect(r.dni).to.eql(\"12345678\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Atender reporte",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/reportes/{{reporteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado atendido\", () => pm.expect(pm.response.json().estado).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Comprobar persistencia de atención",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/{{reporteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado guardado\", () => pm.expect(pm.response.json().estado).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Siguientes cinco",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/?offset=5&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Reporte inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/99999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Validar DNI incorrecto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reportes/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"123\",\n  \"tipo\": \"MALEZA\",\n  \"direccion\": \"Calle Uno\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Validar paginación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reportes/?offset=-1&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}